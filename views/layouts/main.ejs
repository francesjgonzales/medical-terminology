<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description"
    content="A comprehensive medical terminology dictionary designed for beginners learning anatomy and physiology. Simplify complex terms and enhance your understanding.">
  <title>
    Medical Terminology
  </title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  <link rel="stylesheet" href="/style.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link
    href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,300..900;1,300..900&family=Outfit:wght@100..900&family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&display=swap"
    rel="stylesheet">

</head>

<body>
  <div class="container mt-5">
    <%- include('../partials/header.ejs') %>

      <%- body %>
  </div>



  <!-- JavaScript for Dynamic Filtering -->
  <script>
    // Get buttons and the list items
    const filterRootButton = document.getElementById('filterRoot');
    const filterPrefixButton = document.getElementById('filterPrefix');
    const filterAnatomyPhysioButton = document.getElementById('filterAnatomyPhysio');
    const showAllButton = document.getElementById('showAll');
    const termsList = document.querySelectorAll('#termsList td');
    /* const termsList = document.querySelectorAll('#termsList li'); */

    // Filter Function
    function filterTerms(condition) {
      termsList.forEach(term => {
        const termName = term.getAttribute('data-term');
        if (condition(termName)) {
          term.classList.remove('hidden');
        } else {
          term.classList.add('hidden');
        }
      });
    }

    // Event Listeners
    filterRootButton.addEventListener('click', () => {
      filterTerms(term => term === "Term with no root");
    });

    filterPrefixButton.addEventListener('click', () => {
      filterTerms(term => term === "Term with no prefix");
    });

    filterAnatomyPhysioButton.addEventListener('click', () => {
      filterTerms(term => term === "Terms related to anatomy and physiology");
    });

    showAllButton.addEventListener('click', () => {
      termsList.forEach(term => term.classList.remove('hidden'));
    });
  </script>
  <!-- Bootstrap Javascript -->
  <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"
    integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r"
    crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.min.js"
    integrity="sha384-BBtl+eGJRgqQAUMxJ7pMwbEyER4l1g+O15P+16Ep7Q9Q+zqX6gSbd85u4mG4QzX+"
    crossorigin="anonymous"></script>

</body>

</html>