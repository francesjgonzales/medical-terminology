<div class="container">
    <section>
        <div class="container">

            <% noRoot.map((noRoot)=> { %>
                <%= noRoot.category %>

                    <% }); %>
        </div>
    </section>
    <section>
        <div class="container">

            <% anatomyPhysiology.map((anatomyPhysiology)=> { %>
                <%= anatomyPhysiology.category %>

                    <% }); %>
        </div>
    </section>
    <table class="table">
        <thead>
            <tr>
                <th scope="col">Term</th>
                <th scope="col">Definition</th>
                <th scope="col">Category</th>
                <th></th>
                <th></th>
                <th></th>
            </tr>
        </thead>
        <tbody id="">
            <% for( let index=0; index < noPrefix.length; index++ ) { %>
                <tr>
                    <td>
                        <%= noPrefix[index].term %>
                    </td>
                    <td>
                        <%= noPrefix[index].definition %>
                    </td>
                    <td>
                        <%= noPrefix[index].category %>
                    </td>

                    <% } %>
    </table>
</div>

</tbody>