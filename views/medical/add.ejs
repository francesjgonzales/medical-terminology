<section class="container-sm mt-5">
    <h2>Add your term</h2>

    <form method="POST" id="myForm" action="/" class="form">
        <div class="mb-3">
            <label>Medical Term</label>
            <input name="term" id="term" type="text" class="form-control" required />
            <div class="valid-feedback">
                This word exists in the Medical Term
            </div>
        </div>
        <div class="mb-3">
            <label>Description</label>
            <textarea name="definition" id="definition" type="text" class="form-control" style="height: 100px"
                required></textarea>
        </div>
        <div class="mb-3">
            <select name="category" id="category" type="text" class="form-select" required>
                <option value="" selected>Add the category</option>
                <option value="Term with no root">Terms with no root</option>
                <option value="Term with no prefix">Terms with no prefix</option>
                <option value="Terms related to anatomy and physiology">Terms related to anatomy and physiology</option>
            </select>
        </div>
        <div class="mb-3">
            <button type="reset" class="btn btn-outline-light"><a href="/"
                    class="text-decoration-none">Cancel</a></button>
            <button type="submit" class="btn btn-primary">Submit</button>
        </div>
    </form>

</section>