<section class="container-sm mt-5">
    <h1>Medical Terminology</h1>
    <div class="btn-group me-2">
        <a href="/add" class="btn btn-sm btn-outline-primary">+ Add Term</a>
    </div>

    <div class="container mt-5">
        <form class="nav col-12 col-md-auto flex-fill mb-2 justify-content-center mb-md-0" role="search" method="POST"
            action="/search">
            <input type="search" name="searchTerm" class="form-control form-control-dark w-100 rounded-0 border-0"
                placeholder="Search..." aria-label="Search">
        </form>
    </div>

    <div class="mt-5">
        <div class="mt-3">
            <!-- flash messages -->
            <% message.forEach(medicalData=> { %>
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <%= medicalData %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
                <% }) %>
        </div>
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">Term</th>
                    <th scope="col">Definition</th>
                    <th scope="col">Category</th>
                    <th></th>
                    <th></th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="">
                <% for( let index=0; index < medicalData.length; index++ ) { %>
                    <tr>
                        <td>
                            <%= medicalData[index].term %>
                        </td>
                        <td>
                            <%= medicalData[index].definition %>
                        </td>
                        <td>
                            <%= medicalData[index].category %>
                        </td>
                        <td>
                            <button class="btn btn-link"> <a href="/view/<%= medicalData[index]._id %>"><i
                                        class="bi bi-eye"></i></a>
                            </button>
                        </td>
                        <td>
                            <button class="btn btn-link"> <a href="/edit/<%= medicalData[index]._id %>"><i
                                        class="bi bi-pen"></i></a></button>
                        </td>
                        <td>
                            <form action="/edit/<%= medicalData[index]._id %>?_method=DELETE" method="POST"
                                class="position-relative">
                                <button type="submit" class="btn btn-link">
                                    <i class="bi bi-x-circle"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                    <% } %>
            </tbody>
        </table>
    </div>
</section>